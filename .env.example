# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_ENV=development  # development, staging, production

# Database Configuration (Core/Metadata Database)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=flow
DB_SSL_MODE=disable  # disable, require, verify-ca, verify-full

# JWT Configuration
# IMPORTANT: Change this secret in production! Use a strong random string.
JWT_SECRET=your-secret-key-change-this-in-production

# CORS Configuration
# Comma-separated list of allowed origins
# Development: Allow local frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Production example:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Optional: If you want to configure frontend build output
# FRONTEND_BUILD_PATH=../frontend/dist
